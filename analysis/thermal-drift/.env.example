# Copy to .env (gitignored) and fill in. Get the token from HALOS:
#   ssh halos "docker exec influxdb influx auth list"
# or from /etc/rpi-clone-backup/backup.conf on the Pi (INFLUXDB_TOKEN field).
INFLUXDB_URL=http://halos.local:4432/influxdb
INFLUXDB_TOKEN=
INFLUXDB_ORG=marine
INFLUXDB_BUCKET=signalk
